{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "B:/**" },
        { "path": "D:/**" },
        { "path": "E:/**" }
      ]
    },
    { "identifier": "opener:allow-open-url", "allow": [{ "url": "wartribes-tour://*" }] },
    "dialog:allow-open"
  ]
}
